{
  "name": "dsh-usage",
  "version": "0.1.0",
  "description": "DSH plugin: query provider quota/balance (Kimi / Zhipu GLM / DeepSeek / Volcengine / custom API) and show a live usage badge bar under the composer.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "usage",
    "quota",
    "balance",
    "deepseek",
    "kimi",
    "zhipu",
    "volcengine"
  ],
  "author": "heekei",
  "license": "MIT",
  "homepage": "https://github.com/heekei/dsh-usage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heekei/dsh-usage.git"
  },
  "bugs": {
    "url": "https://github.com/heekei/dsh-usage/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
